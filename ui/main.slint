// Lucentia's main window: live preview on the left, settings on the right.

import { Button, CheckBox, ComboBox, SpinBox, Slider, ScrollView, GroupBox, AboutSlint, LineEdit, Palette } from "std-widgets.slint";

component Label inherits Text {
    color: Palette.foreground.transparentize(0.3);
    font-size: 12px;
    vertical-alignment: center;
}

component Row inherits HorizontalLayout {
    spacing: 8px;
    alignment: stretch;
}

component Hint inherits Text {
    color: Palette.foreground.transparentize(0.4);
    font-size: 11px;
    wrap: word-wrap;
}

// A mute toggle with an icon and a short label, shown under the preview.
component MuteButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> muted: false;
    callback clicked();
    height: 32px;
    width: row.preferred-width;
    border-radius: 16px;
    background: root.muted ? #d0303040 : (touch.has-hover ? Palette.foreground.transparentize(0.85) : Palette.foreground.transparentize(0.92));
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 8px;
        Image {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.muted ? #e04548 : Palette.foreground;
        }
        Text {
            text: root.text;
            color: root.muted ? #e04548 : Palette.foreground;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Record / Stop.
component RecordButton inherits Rectangle {
    in property <string> text;
    in property <bool> busy: false;
    in property <bool> recording: false;
    callback clicked();
    height: 44px;
    border-radius: 8px;
    background: root.busy ? #6b7280
        : root.recording ? (touch.has-hover ? #c9363a : #b3272b)
        : (touch.has-hover ? #e04548 : #d23a3d);
    Text {
        text: root.text;
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
    }
    touch := TouchArea {
        enabled: !root.busy;
        clicked => { root.clicked(); }
    }
}

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.foreground;
    spacing: 2px;
    alignment: center;
    Text { text: root.label; color: Palette.foreground.transparentize(0.4); font-size: 10px; }
    Text { text: root.value; color: root.value-color; font-size: 15px; font-weight: 600; }
}

export component AppWindow inherits Window {
    title: "Lucentia";
    preferred-width: 1360px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Palette.background;

    // Preview
    in property <image> preview;
    in property <bool> has-preview: false;
    // Width / height of the video, so the preview box keeps its shape.
    in property <float> preview-aspect: 16 / 9;
    in property <string> preview-message: "Starting preview…";

    // Source
    in property <[string]> devices;
    in-out property <int> device-index: 0;
    in property <[string]> resolutions;
    in-out property <int> resolution-index: 0;
    in property <[string]> rates;
    in-out property <int> rate-index: 0;
    in property <bool> hdr-available: false;
    in-out property <bool> hdr: false;
    in-out property <bool> hdr-signal: false;
    in property <string> mode-note;

    // Video
    in property <[string]> codecs: ["HEVC", "AV1", "H.264", "Raw (uncompressed)"];
    in-out property <int> codec-index: 0;
    in property <[string]> rate-modes: ["Constant bitrate (CBR)", "Variable bitrate (VBR)", "Constant quality"];
    in-out property <int> rate-mode-index: 0;
    in-out property <int> bitrate: 40;
    in-out property <int> quality: 20;
    in-out property <bool> analysis: false;
    in property <string> estimate;

    // Audio
    in-out property <bool> game-audio: true;
    in-out property <float> game-volume: 100;
    in property <[string]> mics;
    in-out property <int> mic-index: 0;
    in-out property <float> mic-volume: 100;
    in-out property <int> mic-offset: 0;
    in-out property <bool> mix-track: true;
    // Mute what plays on the speakers (not the recording), and mute the mic.
    in-out property <bool> listen-muted: false;
    in-out property <bool> mic-muted: false;
    // Record button text while a recording is being finished.
    in property <string> finish-text: "Finishing…";

    // Output
    in property <[string]> formats: ["MKV (recommended)", "MP4"];
    in-out property <int> format-index: 0;
    in property <string> output-folder;
    in-out property <bool> ask-save: true;
    callback ask-save-changed(bool);

    // Session
    in property <bool> recording: false;
    in property <bool> busy: false;
    in property <string> fps-text: "–";
    in property <string> time-text: "0:00";
    in property <string> size-text: "–";
    in property <string> bitrate-text: "–";
    in property <string> lost-text: "0";
    in property <bool> lost-warning: false;
    in property <string> drive-text: "–";
    in property <string> message;
    in property <bool> message-is-error: false;
    in property <bool> message-is-success: false;
    in property <string> version;

    // Appearance: 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> theme-index: 0;
    callback theme-changed(int);
    public function apply-theme() {
        Palette.color-scheme = root.theme-index == 1 ? ColorScheme.light
            : root.theme-index == 2 ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    callback device-changed();
    callback mode-changed();
    callback settings-changed();
    callback game-audio-toggled();
    callback audio-levels-changed();
    callback record-clicked();
    callback choose-folder();
    callback open-folder();
    // The settings panel was shown or hidden (to remember it).
    callback settings-toggled();
    in-out property <bool> settings-open: false;

    function toggle-settings() {
        root.settings-open = !root.settings-open;
        root.settings-toggled();
    }

        // ---- Preview -------------------------------------------------------------
        VerticalLayout {
            padding: 16px;
            padding-top: 10px;
            spacing: 12px;

            // Top bar: name on the left, Settings on the right.
            HorizontalLayout {
                height: 40px;
                Text {
                    text: "Lucentia";
                    color: Palette.foreground;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: gear-row.preferred-width;
                    border-radius: 8px;
                    background: Palette.foreground.transparentize(gear-touch.has-hover ? 0.85 : 0.92);
                    gear-row := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 8px;
                        Image {
                            width: 20px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("icons/settings.svg");
                            colorize: Palette.foreground;
                        }
                        Text {
                            text: "Settings";
                            color: Palette.foreground;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                    gear-touch := TouchArea {
                        clicked => { root.toggle-settings(); }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // Room kept under the video for the controls.
                property <length> under: 54px;
                // The video box: as big as fits while keeping the video's shape, so
                // the picture always fills it and there are no bars on resize.
                video-box := Rectangle {
                    width: min(parent.width, (parent.height - parent.under) * root.preview-aspect);
                    height: self.width / root.preview-aspect;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - parent.under - self.height) / 2;
                    background: #000000;
                    border-radius: 8px;
                    clip: true;

                    if root.has-preview: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.preview;
                        image-fit: fill;
                    }
                    if !root.has-preview: Text {
                        text: root.preview-message;
                        color: #8a93a3;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Recording badge.
                    if root.recording: Rectangle {
                        x: 14px;
                        y: 14px;
                        width: badge.preferred-width + 24px;
                        height: 28px;
                        border-radius: 14px;
                        background: #000000b0;
                        badge := HorizontalLayout {
                            padding-left: 12px;
                            spacing: 8px;
                            alignment: start;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: #ff4d4f;
                            }
                            Text {
                                text: "REC  " + root.time-text + "   ·   " + root.size-text + "   ·   " + root.bitrate-text;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                }

                // Right under the video: mutes, live stats, Record.
                HorizontalLayout {
                    x: video-box.x;
                    y: video-box.y + video-box.height + 10px;
                    width: video-box.width;
                    height: 44px;
                    // Tighter on small windows so the row stays as wide as the video.
                    spacing: video-box.width < 1000px ? 12px : 22px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        if root.game-audio: MuteButton {
                            y: (parent.height - self.height) / 2;
                            icon: root.listen-muted ? @image-url("icons/speaker-off.svg") : @image-url("icons/speaker.svg");
                            text: "Audio";
                            muted: root.listen-muted;
                            clicked => { root.listen-muted = !root.listen-muted; root.audio-levels-changed(); }
                        }
                        if root.mic-index > 0: MuteButton {
                            y: (parent.height - self.height) / 2;
                            icon: root.mic-muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                            text: "Mic";
                            muted: root.mic-muted;
                            clicked => { root.mic-muted = !root.mic-muted; root.audio-levels-changed(); }
                        }
                    }
                    Stat { label: "FRAME RATE"; value: root.fps-text; }
                    Stat { label: "LOST FRAMES"; value: root.lost-text; value-color: root.lost-warning ? #e09000 : Palette.foreground; }
                    Stat { label: "FILE SIZE"; value: root.size-text; }
                    Stat { label: "BITRATE"; value: root.recording ? root.bitrate-text : "–"; }
                    Stat { label: "DISK SPACE LEFT"; value: root.drive-text; }
                    Rectangle { horizontal-stretch: 1; }
                    RecordButton {
                        y: (parent.height - self.height) / 2;
                        width: 160px;
                        busy: root.busy;
                        recording: root.recording;
                        text: root.busy ? root.finish-text : root.recording ? "Stop recording" : "Record";
                        clicked => { root.record-clicked(); }
                    }
                }

            }

            if root.message != "": Rectangle {
                height: msg.preferred-height + 16px;
                border-radius: 6px;
                background: root.message-is-error ? #d0303033
                    : root.message-is-success ? #20a04a2e
                    : #e0a00026;
                msg := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: root.message;
                    color: Palette.foreground;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }

        // ---- Settings drawer ------------------------------------------------------
        // Slides in from the right over the preview. Click outside it to close.
        // The dimmed backdrop fades in and out with the drawer.
        Rectangle {
            background: #00000060;
            opacity: root.settings-open ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: 300ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
            TouchArea {
                enabled: root.settings-open;
                clicked => { root.toggle-settings(); }
            }
        }
        Rectangle {
            x: root.settings-open ? parent.width - self.width : parent.width;
            y: 0;
            width: 400px;
            height: parent.height;
            // Material-style "standard" curve: eases in and out, so the slide reads as
            // motion instead of a jump.
            animate x { duration: 300ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
            background: Palette.alternate-background;
            drop-shadow-blur: 24px;
            visible: self.x < parent.width;
            drop-shadow-color: #00000070;
            // Swallow clicks so they don't reach the preview underneath.
            TouchArea { }

            VerticalLayout {
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        HorizontalLayout {
                            Text {
                                text: "Settings";
                                color: Palette.foreground;
                                font-size: 22px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 6px;
                                background: close-touch.has-hover ? Palette.foreground.transparentize(0.85) : transparent;
                                Text {
                                    text: "✕";
                                    color: Palette.foreground;
                                    font-size: 16px;
                                }
                                close-touch := TouchArea {
                                    clicked => { root.toggle-settings(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Source";
                            enabled: !root.recording && !root.busy;
                            VerticalLayout {
                                spacing: 8px;
                                ComboBox {
                                    model: root.devices;
                                    current-index <=> root.device-index;
                                    selected => { root.device-changed(); }
                                }
                                Row {
                                    Label { text: "Resolution"; width: 90px; }
                                    ComboBox {
                                        model: root.resolutions;
                                        current-index <=> root.resolution-index;
                                        selected => { root.mode-changed(); }
                                    }
                                }
                                Row {
                                    Label { text: "Frame rate"; width: 90px; }
                                    ComboBox {
                                        model: root.rates;
                                        current-index <=> root.rate-index;
                                        selected => { root.mode-changed(); }
                                    }
                                }
                                CheckBox {
                                    text: "10-bit HDR";
                                    enabled: root.hdr-available;
                                    checked <=> root.hdr;
                                    toggled => { root.mode-changed(); }
                                }
                                CheckBox {
                                    text: "Source is HDR in 8-bit (tone map it)";
                                    enabled: !root.hdr;
                                    checked <=> root.hdr-signal;
                                    toggled => { root.mode-changed(); }
                                }
                                Hint { text: root.mode-note; }
                            }
                        }

                        GroupBox {
                            title: "Video";
                            enabled: !root.recording && !root.busy;
                            VerticalLayout {
                                spacing: 8px;
                                Row {
                                    Label { text: "Codec"; width: 90px; }
                                    ComboBox {
                                        model: root.codecs;
                                        current-index <=> root.codec-index;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                Row {
                                    Label { text: "Rate control"; width: 90px; }
                                    ComboBox {
                                        model: root.rate-modes;
                                        enabled: root.codec-index != 3;
                                        current-index <=> root.rate-mode-index;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                if root.rate-mode-index != 2 && root.codec-index != 3: Row {
                                    Label { text: "Bitrate (Mbit/s)"; width: 90px; }
                                    SpinBox {
                                        minimum: 1;
                                        maximum: 1000;
                                        value <=> root.bitrate;
                                        edited => { root.settings-changed(); }
                                    }
                                }
                                if root.rate-mode-index == 2 && root.codec-index != 3: Row {
                                    Label { text: "Quality (0 best)"; width: 90px; }
                                    SpinBox {
                                        minimum: 0;
                                        maximum: 51;
                                        value <=> root.quality;
                                        edited => { root.settings-changed(); }
                                    }
                                }
                                CheckBox {
                                    text: "Analysis mode (every frame a keyframe)";
                                    enabled: root.codec-index != 3;
                                    checked <=> root.analysis;
                                    toggled => { root.settings-changed(); }
                                }
                                Text {
                                    text: root.estimate;
                                    color: Palette.foreground.transparentize(0.15);
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        GroupBox {
                            title: "Audio";
                            enabled: !root.recording && !root.busy;
                            VerticalLayout {
                                spacing: 8px;
                                Row {
                                    CheckBox {
                                        text: "Game audio";
                                        checked <=> root.game-audio;
                                        toggled => { root.game-audio-toggled(); }
                                    }
                                }
                                Row {
                                    Label { text: "Game " + round(root.game-volume) + "%"; width: 90px; }
                                    Slider {
                                        minimum: 0;
                                        maximum: 200;
                                        step: 5;
                                        value <=> root.game-volume;
                                        changed(v) => {
                                            // Snap to 5% steps.
                                            root.game-volume = round(v / 5) * 5;
                                            root.audio-levels-changed();
                                        }
                                    }
                                }
                                Row {
                                    Label { text: "Mic"; width: 90px; }
                                    ComboBox {
                                        model: root.mics;
                                        current-index <=> root.mic-index;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                if root.mic-index > 0: Row {
                                    Label { text: "Mic " + round(root.mic-volume) + "%"; width: 90px; }
                                    Slider {
                                        minimum: 0;
                                        maximum: 200;
                                        step: 5;
                                        value <=> root.mic-volume;
                                        changed(v) => {
                                            root.mic-volume = round(v / 5) * 5;
                                            root.audio-levels-changed();
                                        }
                                    }
                                }
                                if root.mic-index > 0: Row {
                                    Label { text: "Mic sync (ms)"; width: 90px; }
                                    SpinBox {
                                        minimum: -500;
                                        maximum: 500;
                                        step-size: 5;
                                        value <=> root.mic-offset;
                                        edited => { root.settings-changed(); }
                                    }
                                }
                                if root.mic-index > 0: CheckBox {
                                    text: "Add a Game + Mic track (plays by default)";
                                    checked <=> root.mix-track;
                                    toggled => { root.settings-changed(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Output";
                            enabled: !root.recording && !root.busy;
                            VerticalLayout {
                                spacing: 8px;
                                ComboBox {
                                    model: root.formats;
                                    current-index <=> root.format-index;
                                    selected => { root.settings-changed(); }
                                }
                                Hint {
                                    text: root.format-index == 0
                                        ? "Still playable if the app, the system or the power cuts out mid-recording, and players show the track names."
                                        : "Recorded as MKV for safety, then converted to MP4 when you stop. For editors or sites that only take MP4.";
                                }
                                Row {
                                    LineEdit {
                                        text: root.output-folder;
                                        read-only: true;
                                    }
                                    Button {
                                        text: "Change";
                                        clicked => { root.choose-folder(); }
                                    }
                                }
                                CheckBox {
                                    text: "Ask where to save each recording";
                                    checked <=> root.ask-save;
                                    toggled => { root.ask-save-changed(root.ask-save); }
                                }
                                Button {
                                    text: "Open recordings folder";
                                    clicked => { root.open-folder(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Appearance";
                            ComboBox {
                                model: ["Auto (follow system)", "Light", "Dark"];
                                current-index <=> root.theme-index;
                                selected => {
                                    root.apply-theme();
                                    root.theme-changed(root.theme-index);
                                }
                            }
                        }

                        GroupBox {
                            title: "About";
                            VerticalLayout {
                                spacing: 8px;
                                Hint {
                                    text: "Lucentia " + root.version + " by Daggenthal. MIT licensed. Captures from Elgato and other UVC cards with GStreamer.";
                                }
                                AboutSlint { }
                            }
                        }
                    }
                }

            }
        }
}
